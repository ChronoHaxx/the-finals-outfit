    "stage:assets": "node scripts/stage-assets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "three": "^0.184.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
