    "discover:assets": "tsx scripts/discover-assets.ts",
    "convert:meshes": "node scripts/convert-meshes.mjs",
    "build:eyes": "node scripts/build-eye-textures.mjs",
    "build:regions": "node scripts/build-regions.mjs",
    "build:hair-coverage": "node scripts/build-hair-coverage.mjs",
    "bake:composite": "node scripts/bake-composite.mjs",
    "scan:white-patches": "node scripts/scan-white-patches.mjs",
    "publish:models": "node scripts/publish-models.mjs",
    "visual:render": "node scripts/visual-diff/render.mjs",
    "visual:compare": "node scripts/visual-diff/compare.mjs",
